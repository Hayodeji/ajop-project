PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (frontend dev + prod)
CORS_ORIGINS=http://localhost:5173

# WhatsApp Business API (Meta Cloud API v19.0+)
# Leave blank to disable WhatsApp reminders
# WHATSAPP_API_URL: Use https://graph.instagram.com/v19.0 (or latest version)
# WHATSAPP_API_TOKEN: Get from your Meta Business Account (needs whatsapp_business_messaging permission)
# WHATSAPP_PHONE_ID: Your WhatsApp Business Phone Number ID
# WHATSAPP_VERIFY_TOKEN: Your webhook verification token (for incoming messages)
WHATSAPP_API_URL=https://graph.instagram.com/v19.0
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token

# Comma-separated list of super-admin phone numbers (normalised +234 format)
SUPER_ADMIN_PHONES=+2349065543761,+2347033139259
